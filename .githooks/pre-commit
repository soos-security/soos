#!/usr/bin/env bash
# =============================================================================
# .githooks/pre-commit — Local Git security guardrails for soos
# =============================================================================
# 1. Blocks direct commits to the 'main' branch
# 2. Scans staged changes for secrets and sensitive artifacts (scripts/secret_scan.sh)
# 3. Runs the deterministic candid invariant checks (scripts/candid_review.sh)
#
# The fingerprint-bound AI review gate (Layer 2) is enforced before pushing
# (.githooks/pre-push, save.sh, and CI), so intermediate commits stay possible.
# =============================================================================

set -euo pipefail

# 1. Branch verification: prevent direct commit on main
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

if [[ "$CURRENT_BRANCH" == "main" && "${ALLOW_MAIN_COMMIT:-0}" != "1" ]]; then
    echo -e "\033[0;31m[BLOCKED]\033[0m Direct commits to the 'main' branch are strictly prohibited!" >&2
    echo -e "          Please create a dedicated feature/fix branch for your work:" >&2
    echo -e "            git checkout -b feat/<name>   # for new features" >&2
    echo -e "            git checkout -b fix/<name>    # for bug fixes" >&2
    echo -e "            git checkout -b chore/<name>  # for tooling / CI / docs" >&2
    echo -e "          (Emergency override: ALLOW_MAIN_COMMIT=1 git commit ...)" >&2
    exit 1
fi

# 2. Secret and sensitive artifact scan on the staged index
if ! ./scripts/secret_scan.sh --staged; then
    echo -e "\033[0;31m[BLOCKED]\033[0m Secret or sensitive artifact detected in staged changes." >&2
    exit 1
fi

# 3. Deterministic candid invariant checks (architecture, panic safety, English policy)
if ! ./scripts/candid_review.sh; then
    echo -e "\033[0;31m[BLOCKED]\033[0m Candid review failed architectural invariant or language checks!" >&2
    echo -e "          Resolve the invariant errors above before committing." >&2
    exit 1
fi

exit 0
