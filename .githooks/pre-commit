#!/usr/bin/env bash
# =============================================================================
# .githooks/pre-commit — Local Git security guardrails for soos
# =============================================================================
# 1. Blocks direct commits to the 'main' branch
# 2. Scans staged diffs for private keys, certificates, and API tokens
# =============================================================================

set -euo pipefail

# 1. Branch verification: prevent direct commit on main
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

if [[ "$CURRENT_BRANCH" == "main" && "${ALLOW_MAIN_COMMIT:-0}" != "1" ]]; then
    echo -e "\033[0;31m[BLOCKED]\033[0m Direct commits to the 'main' branch are strictly prohibited!" >&2
    echo -e "          Please create a dedicated feature/fix branch for your work:" >&2
    echo -e "            git checkout -b feat/<name>   # for new features" >&2
    echo -e "            git checkout -b fix/<name>    # for bug fixes" >&2
    echo -e "            git checkout -b chore/<name>  # for tooling / CI / docs" >&2
    echo -e "          (Emergency override: ALLOW_MAIN_COMMIT=1 git commit ...)" >&2
    exit 1
fi

# 2. Secret leak prevention in staged files
while IFS= read -r -d '' file; do
    [[ ! -f "$file" ]] && continue

    # Block sensitive files by extension or pattern
    case "$file" in
        *.pem|*.key|id_rsa*|id_ed25519*|*.p12|*.pfx|*.secret)
            echo -e "\033[0;31m[BLOCKED]\033[0m Sensitive key or certificate file detected: $file" >&2
            exit 1
            ;;
    esac

    # Block private key markers inside file content diffs
    if git diff --cached "$file" | grep -qE "BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY"; then
        echo -e "\033[0;31m[BLOCKED]\033[0m Private key pattern detected in diff of: $file" >&2
        exit 1
    fi

    # Block common GitHub personal access tokens
    if git diff --cached "$file" | grep -qE "(ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82})"; then
        echo -e "\033[0;31m[BLOCKED]\033[0m GitHub access token detected in diff of: $file" >&2
        exit 1
    fi
done < <(git diff --cached --name-only -z)

# 3. Candid Pre-Commit Review (Architectural Invariants & English Policy)
if [[ -f "./scripts/candid_subagent.sh" ]]; then
    if ! ./scripts/candid_subagent.sh; then
        echo -e "\033[0;31m[BLOCKED]\033[0m Candid review failed invariant checks or AI sub-agent review!" >&2
        echo -e "          Resolve the invariant errors above before committing." >&2
        exit 1
    fi
elif [[ -f "./scripts/candid_review.sh" ]]; then
    if ! ./scripts/candid_review.sh; then
        echo -e "\033[0;31m[BLOCKED]\033[0m Candid review failed architectural invariant or language checks!" >&2
        echo -e "          Resolve the invariant errors above before committing." >&2
        exit 1
    fi
fi

exit 0
