# =============================================================================
# Dockerfile.arch — Isolated Arch Linux PAM Sandbox for soos
# =============================================================================

# Base image pinned by its multi-arch index digest (GitHub #316 TCI-NEW-3, resolved
# 2026-10-02): a re-tagged upstream image can no longer change the sandbox between
# two runs. Bump the digest deliberately (docker manifest inspect <image>:<tag>).
# Arch is rolling: the pinned base is still upgraded by `pacman -Syu` below.
FROM archlinux:latest@sha256:b21322c663be387c0ed9cbc7bbbfe18e41633ad4e7b7c77cfad45f128be20040

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"

# Install Arch Linux system dependencies
RUN pacman -Syu --noconfirm \
        base-devel \
        pam \
        clang \
        python \
        curl \
        ca-certificates \
        git \
    && pacman -Scc --noconfirm

# Install Rust toolchain: verified rustup-init (pinned SHA-256, no curl | sh, GitHub #260)
COPY scripts/install_rustup.sh /usr/local/lib/soos/install_rustup.sh
RUN bash /usr/local/lib/soos/install_rustup.sh --default-toolchain 1.98.1 \
    && rustup component add clippy rustfmt

# Create testuser with known password
RUN useradd -m -s /bin/bash testuser \
    && echo "testuser:password123" | chpasswd

# Configure Arch Linux test PAM stack (/etc/pam.d/test-soos)
# printf '%s\n' writes one argument per line on every /bin/sh (dash on Ubuntu,
# bash on Fedora/Arch). Never use `echo "...\n..."`: bash's builtin echo writes a
# literal backslash-n and PAM would see a single comment line (GitHub #162).
RUN printf '%s\n' \
        '# Test PAM service for soos (Arch Linux)' \
        'auth  [success=done default=ignore]  pam_soos.so timeout_ms=250' \
        'auth  required                       pam_unix.so' \
        'account required pam_unix.so' \
        'session required pam_unix.so' \
    > /etc/pam.d/test-soos

# Keep the pristine pambase system-auth before the synthetic one below replaces it
# (GitHub #309): tests/distro/arch_linux_test.sh verifies this copy against the
# pambase mtree digest and applies the documented soos edit to the real stock stack.
# (cd + relative name: this RUN writes no PAM service, see distro_matrix.rs.)
RUN install -d -m 0755 /usr/local/share/soos-test \
    && cd /etc/pam.d \
    && cp -p system-auth /usr/local/share/soos-test/system-auth.stock

# Configure Arch Linux system-auth integration
RUN printf '%s\n' \
        '# /etc/pam.d/system-auth integration for soos' \
        'auth  [success=done default=ignore]  pam_soos.so timeout_ms=250' \
        'auth  required                       pam_unix.so try_first_pass nullok' \
        'account required pam_unix.so' \
        'session required pam_unix.so' \
    > /etc/pam.d/system-auth

# Provision /var/lib/soos/models directory
RUN mkdir -p /var/lib/soos/models && chmod 755 /var/lib/soos/models

WORKDIR /workspace

CMD ["bash"]
