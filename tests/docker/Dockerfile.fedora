# =============================================================================
# Dockerfile.fedora — Isolated RHEL / Fedora PAM Sandbox for soos
# =============================================================================

FROM fedora:40

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"

# Install Fedora packages
# openssl-devel: headers for openssl-sys (ort download path) in full workspace builds.
# rpm-build, systemd-rpm-macros, cargo, rust: BuildRequires of packaging/rpm/soos.spec,
# so tests/distro/fedora_rhel_test.sh exercises the RPM path (the rustup toolchain
# below stays first in PATH and performs the actual build).
# procps-ng: pkill, used by the test cleanup handlers.
# systemd: runtime Requires of the RPM (not started as init); authselect: activated
# for real by fedora_rhel_test.sh (not part of the fedora:40 base image).
# diffutils: Requires(posttrans) of the RPM (cmp in the master-key upgrade guard, #281).
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc \
        gcc-c++ \
        make \
        pkgconf-pkg-config \
        pam-devel \
        clang-devel \
        openssl-devel \
        rpm-build \
        systemd-rpm-macros \
        cargo \
        rust \
        python3 \
        curl \
        ca-certificates \
        git \
        util-linux \
        shadow-utils \
        procps-ng \
        systemd \
        authselect \
        diffutils \
    && dnf clean all

# Install Rust toolchain (RUSTUP_INIT_SKIP_PATH_CHECK: rustup coexists with the
# distribution cargo/rust packages installed above for the RPM BuildRequires)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | RUSTUP_INIT_SKIP_PATH_CHECK=yes sh -s -- -y --default-toolchain 1.98.1 --profile minimal \
    && rustup component add clippy rustfmt \
    && command -v cargo | grep -qx /usr/local/cargo/bin/cargo

# Create testuser with known password
RUN useradd -m -s /bin/bash testuser \
    && echo "testuser:password123" | chpasswd

# Configure Fedora test PAM stack (/etc/pam.d/test-soos)
# printf '%s\n' writes one argument per line on every /bin/sh (dash on Ubuntu,
# bash on Fedora/Arch). Never use `echo "...\n..."`: bash's builtin echo writes a
# literal backslash-n and PAM would see a single comment line (GitHub #162).
RUN printf '%s\n' \
        '# Test PAM service for soos (Fedora/RHEL)' \
        'auth  [success=done default=ignore]  pam_soos.so timeout_ms=250' \
        'auth  required                       pam_unix.so' \
        'account required pam_unix.so' \
        'session required pam_unix.so' \
    > /etc/pam.d/test-soos

# Configure Fedora / RHEL system-auth integration
RUN printf '%s\n' \
        '# /etc/pam.d/system-auth integration for soos' \
        'auth  [success=done default=ignore]  pam_soos.so timeout_ms=250' \
        'auth  sufficient                     pam_unix.so try_first_pass nullok' \
        'auth  required                       pam_deny.so' \
        'account required pam_unix.so' \
        'session required pam_unix.so' \
    > /etc/pam.d/system-auth

# Provision /var/lib/soos/models directory
RUN mkdir -p /var/lib/soos/models && chmod 755 /var/lib/soos/models

WORKDIR /workspace

CMD ["bash"]
