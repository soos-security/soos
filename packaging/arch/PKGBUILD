# Maintainer: soos developers <dev@soos.local>
# =============================================================================
# packaging/arch/PKGBUILD — Arch Linux Package Recipe for soos
# =============================================================================

pkgname=soos
pkgver=0.1.0
pkgrel=1
pkgdesc="Local facial biometric authentication PAM module and daemon for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/Mysticaly622/soos"
license=('AGPL-3.0-or-later')
depends=('pam' 'systemd')
makedepends=('cargo' 'rust' 'clang' 'openssl' 'pkgconf')
# soos-gui loads its windowing and GL libraries with dlopen() (same list as
# scripts/check_build_deps.sh --distro arch --print-packages gui).
optdepends=('libxkbcommon: soos-gui keyboard handling'
            'wayland: soos-gui on Wayland'
            'libglvnd: soos-gui OpenGL / EGL'
            'libx11: soos-gui on X11'
            'libxcursor: soos-gui on X11'
            'libxi: soos-gui on X11'
            'libxrandr: soos-gui on X11')
install=soos.install
# Built from the checked-out repository (makepkg in packaging/arch/): no release tarball is
# published yet, so source=() stays empty and every function works in the source tree
# (override with SOOS_SRC_DIR=/path/to/soos). pkgver/license are checked against the
# [workspace.package] table of Cargo.toml by the soos-invariants suite (GitHub #210).
source=()
_soos_srcdir="${SOOS_SRC_DIR:-${startdir}/../..}"

build() {
    cd "${_soos_srcdir}"
    cargo build --locked --release --workspace
}

package() {
    cd "${_soos_srcdir}"

    # 1. Install binaries
    install -Dm755 "target/release/soos-daemon" "${pkgdir}/usr/libexec/soos/soos-daemon"
    # Key provisioning helper: the master key is generated by post_install on the
    # target host and is never part of the package (GitHub #144).
    install -Dm755 "scripts/provision_master_key.sh" "${pkgdir}/usr/libexec/soos/provision-master-key"
    install -Dm755 "target/release/soos-admin" "${pkgdir}/usr/bin/soos-admin"
    install -Dm755 "target/release/soos-enroll" "${pkgdir}/usr/bin/soos-enroll"
    install -Dm755 "target/release/soos-gui" "${pkgdir}/usr/bin/soos-gui"

    # 2. Install PAM module
    install -Dm644 "target/release/libpam_soos.so" "${pkgdir}/usr/lib/security/pam_soos.so"

    # 3. Install systemd service unit
    install -Dm644 "packaging/soos-daemon.service" "${pkgdir}/usr/lib/systemd/system/soos-daemon.service"

    # 4. Install PAM configuration snippet
    install -Dm644 "packaging/pam/arch/system-auth.snippet" "${pkgdir}/etc/pam.d/soos.snippet"

    # 5. Provision persistent and runtime directory structures
    install -dm755 "${pkgdir}/var/lib/soos"
    install -dm700 "${pkgdir}/var/lib/soos/biometrics"
    install -dm700 "${pkgdir}/var/lib/soos/evidence"
    install -dm755 "${pkgdir}/var/lib/soos/models"
}
