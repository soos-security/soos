# =============================================================================
# packaging/arch/soos.install — Arch Linux Install Scriptlet for soos
# =============================================================================

post_install() {
    # 1. Create system group 'soos' if absent
    if ! getent group soos >/dev/null 2>&1; then
        groupadd -r soos || true
    fi

    # 2. Enforce directory hierarchy and security permissions
    mkdir -p /var/lib/soos/biometrics
    mkdir -p /var/lib/soos/evidence
    mkdir -p /var/lib/soos/models
    mkdir -p /run/soos

    chmod 0755 /var/lib/soos
    chmod 0700 /var/lib/soos/biometrics
    chmod 0700 /var/lib/soos/evidence
    chmod 0755 /var/lib/soos/models
    chmod 0750 /run/soos

    if [ "$(id -u)" -eq 0 ]; then
        chown root:root /var/lib/soos
        chown root:root /var/lib/soos/biometrics
        chown root:root /var/lib/soos/evidence
        chown root:root /var/lib/soos/models
        chown root:soos /run/soos || chown root:root /run/soos
    fi

    # 3. Generate the cryptographic master key on THIS host if absent
    #    (/var/lib/soos/master.key, 32 bytes, mode 0600 root:root).
    #    The key is never part of the package (GitHub #144); the shipped
    #    helper creates it with mode 0600 from inception and never overwrites
    #    an existing key.
    /usr/libexec/soos/provision-master-key --state-dir /var/lib/soos

    # 4. Reload systemd manager configuration
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi

    echo "==> soos installed successfully."
    echo "==> To enable biometric authentication in Arch PAM, integrate /etc/pam.d/soos.snippet into /etc/pam.d/system-auth."
    echo "==> Back it up first (restored by scripts/uninstall.sh): cp /etc/pam.d/system-auth /etc/pam.d/system-auth.soos-backup"
    echo "==> Start and enable daemon: systemctl enable --now soos-daemon.service"
}

post_upgrade() {
    post_install
}

pre_remove() {
    # pacman never edits /etc/pam.d: warn when a manual integration is still active.
    # The lines are harmless once the module is gone ([success=done default=ignore]
    # and optional controls), but they should be reverted.
    if grep -Eqs '^[[:space:]]*-?(auth|account|password|session)[[:space:]].*pam_soos\.so' /etc/pam.d/system-auth; then
        echo "==> WARNING: /etc/pam.d/system-auth still loads pam_soos.so."
        echo "==> Restore it: cp /etc/pam.d/system-auth.soos-backup /etc/pam.d/system-auth"
    fi

    # Stop and disable systemd service
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl stop soos-daemon.service || true
        systemctl disable soos-daemon.service || true
    fi
}

post_remove() {
    rm -rf /run/soos
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi
}
