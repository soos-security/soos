[Unit]
Description=soos Local Facial Biometric Authentication Daemon
Documentation=https://github.com/Mysticaly622/soos
After=local-fs.target systemd-udevd.service
Wants=systemd-udevd.service
# Bounded restarts: a daemon that cannot start (e.g. models not deployed yet)
# must not crash-loop forever (GitHub #167). After 5 failures in 60 s the unit
# enters the failed state; fix the cause, then 'systemctl reset-failed'.
StartLimitIntervalSec=60
StartLimitBurst=5
# No start before the attested models are deployed (GitHub #211): the daemon
# fails closed without them, so a fresh install would only crash-loop. The
# unit is skipped ("condition failed") until scripts/download_models.sh has
# written the manifest; start it afterwards.
ConditionPathExists=/var/lib/soos/models/manifest.toml

[Service]
Type=simple
User=root
Group=soos
ExecStart=/usr/libexec/soos/soos-daemon
Restart=on-failure
RestartSec=2
UMask=0077

# Runtime and persistence directories
RuntimeDirectory=soos
RuntimeDirectoryMode=0750
StateDirectory=soos
StateDirectoryMode=0755
ReadWritePaths=/var/lib/soos /run/soos

# Security Sandbox Directives (ARCHITECTURE.md §10)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
DevicePolicy=closed
DeviceAllow=/dev/video* rw
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
