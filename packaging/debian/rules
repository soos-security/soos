#!/usr/bin/make -f
# =============================================================================
# packaging/debian/rules — Debian package build recipe for soos
# =============================================================================

export DH_VERBOSE = 1

%:
	dh $@

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

override_dh_auto_build:
	cargo build --release --workspace

override_dh_auto_install:
	bash scripts/install.sh \
		--destdir debian/soos \
		--prefix /usr \
		--pam-dir /usr/lib/$(DEB_HOST_MULTIARCH)/security \
		--skip-models \
		--skip-systemd
	# Never ship key material (GitHub #144): the key is generated by postinst.
	bash scripts/check_no_key_material.sh debian/soos

override_dh_auto_test:
	# Tests are executed via cargo test in CI
	cargo test --workspace --no-run || true
