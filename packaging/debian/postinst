#!/bin/sh
# =============================================================================
# packaging/debian/postinst — Debian post-installation hook for soos
# =============================================================================
set -e

case "$1" in
    configure)
        # 1. Create system group 'soos' if absent
        if ! getent group soos >/dev/null 2>&1; then
            if command -v addgroup >/dev/null 2>&1; then
                addgroup --system soos
            elif command -v groupadd >/dev/null 2>&1; then
                groupadd -r soos
            fi
        fi

        # 2. Provision directory hierarchy with invariant permissions
        mkdir -p /var/lib/soos/biometrics
        mkdir -p /var/lib/soos/evidence
        mkdir -p /var/lib/soos/models
        mkdir -p /run/soos
        mkdir -p /usr/libexec/soos

        chmod 0755 /var/lib/soos
        chmod 0700 /var/lib/soos/biometrics
        chmod 0700 /var/lib/soos/evidence
        chmod 0755 /var/lib/soos/models
        chmod 0750 /run/soos

        if [ "$(id -u)" -eq 0 ]; then
            chown root:root /var/lib/soos
            chown root:root /var/lib/soos/biometrics
            chown root:root /var/lib/soos/evidence
            chown root:root /var/lib/soos/models
            chown root:soos /run/soos || chown root:root /run/soos
        fi

        # 3. Generate the cryptographic master key on THIS host if absent
        #    (/var/lib/soos/master.key, 32 bytes, mode 0600 root:root).
        #    The key is never part of the package (GitHub #144); the shipped
        #    helper creates it atomically with mode 0600 from inception and
        #    never overwrites an existing key (upgrades keep enrolled templates
        #    decryptable).
        /usr/libexec/soos/provision-master-key --state-dir /var/lib/soos

        # 4. Integrate PAM configuration via pam-auth-update if present.
        #    Without --force, pam-auth-update never rewrites a locally modified
        #    stack ("Local modifications to /etc/pam.d/common-*, not updating.")
        #    and still exits 0. The administrator's edits are kept, but the skip
        #    (or a failure) is reported instead of being silent (GitHub #281);
        #    the package installation itself never fails because of it.
        if command -v pam-auth-update >/dev/null 2>&1; then
            if ! pam-auth-update --package --enable soos soos-notify; then
                echo "soos: WARNING: pam-auth-update failed; facial authentication is not enabled in the PAM stack." >&2
            fi
            if [ -f /etc/pam.d/common-auth ] && ! grep -q 'pam_soos\.so' /etc/pam.d/common-auth; then
                echo "soos: WARNING: /etc/pam.d/common-auth does not call pam_soos.so (locally modified PAM stack?);" >&2
                echo "soos: WARNING: facial authentication is inactive. Review the stack, then run" >&2
                echo "soos: WARNING: 'pam-auth-update --enable soos soos-notify' (interactive) or add the rules by hand." >&2
            fi
        fi

        # 5. Reload and enable systemd service if systemd is active
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
            systemctl enable soos-daemon.service || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
